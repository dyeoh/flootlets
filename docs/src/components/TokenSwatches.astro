---
import { bg, colorTokens, contrast } from '../lib/tokens';

const ratio = (fg: string, back: string) => {
  const r = contrast(fg, back);
  return r === undefined ? '' : `${r.toFixed(1)}:1`;
};
---

<h2 id="colours">Colours</h2>
<p>
  The ratio is each colour's contrast against the page background (<code>--background</code>) in
  that theme. In Tailwind, each variable is a colour: <code>--primary</code> is
  <code>bg-primary</code>, <code>text-primary</code>, <code>border-primary</code>.
</p>
<table>
  <thead>
    <tr><th>Variable</th><th>Light</th><th>Dark</th></tr>
  </thead>
  <tbody>
    {
      colorTokens.map((t) => (
        <tr>
          <td><code>{t.name}</code></td>
          <td>
            <span class="fl-docs-swatch" style={`background:${t.light}`} />
            <code>{t.light}</code> <small>{ratio(t.light, bg.light)}</small>
          </td>
          <td>
            <span class="fl-docs-swatch" style={`background:${t.dark}`} />
            <code>{t.dark}</code> <small>{ratio(t.dark, bg.dark)}</small>
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
