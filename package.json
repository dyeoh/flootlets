{
  "name": "flootlets",
  "version": "0.2.0",
  "description": "Accessible, themeable SolidJS components for Astro, Solid SSR and static sites",
  "keywords": [
    "solid",
    "solidjs",
    "astro",
    "ssr",
    "components",
    "tailwindcss",
    "shadcn",
    "accessibility"
  ],
  "license": "MIT",
  "author": "dyeoh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyeoh/flootlets.git"
  },
  "homepage": "https://dyeoh.github.io/flootlets/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/source/index.js",
      "default": "./dist/browser/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "types": "./dist/types/index.d.ts",
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build && cp src/styles/theme.css dist/theme.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "commit": "cz",
    "prepare": "simple-git-hooks",
    "docs:dev": "bun run --cwd docs dev",
    "docs:build": "bun run build && bun run registry:build && bun run --cwd docs build",
    "check:exports": "bun scripts/check-exports.ts",
    "check:theme": "bun scripts/check-theme.ts",
    "registry:build": "bun scripts/build-registry.ts",
    "registry:smoke": "bun scripts/registry-smoke.ts"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0",
    "tailwindcss": "^4.1.0"
  },
  "dependencies": {
    "@kobalte/core": "^0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/node": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "axe-core": "^4.14.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10",
    "eslint-plugin-solid": "^0.18.1",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "simple-git-hooks": "^2.14.0",
    "solid-js": "^1.9.17",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^8",
    "vite-plugin-solid": "^2.11",
    "vitest": "^5"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "simple-git-hooks": {
    "commit-msg": "bunx --no-install commitlint --edit \"$1\""
  }
}
